<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-5">
  <div class="col-12 col-md-8 col-lg-6 text-center">
    <div class="empty-state-card py-5 shadow-sm border">
      <div class="empty-state-icon text-danger mb-3">
        <% if (status === 404) { %>
          <i class="fa-solid fa-compass-drafting" style="font-size: 3.5rem;"></i>
        <% } else if (status === 403) { %>
          <i class="fa-solid fa-lock" style="font-size: 3.5rem;"></i>
        <% } else { %>
          <i class="fa-solid fa-triangle-exclamation" style="font-size: 3.5rem;"></i>
        <% } %>
      </div>

      <h1 class="h2 fw-bold text-dark mb-2">
        <%= status || 500 %> — <%= status === 404 ? "Page Not Found" : (status === 403 ? "Access Denied" : "Something Went Wrong") %>
      </h1>

      <p class="text-muted mb-4 mx-auto" style="max-width: 440px;">
        <%= message || "We could not process your request. Please try again or return to the main listings catalog." %>
      </p>

      <div class="d-flex justify-content-center gap-2">
        <a href="/listings" class="btn btn-brand px-4 py-2">
          <i class="fa-solid fa-house me-1"></i> Return to All Stays
        </a>
      </div>
    </div>
  </div>
</div>
