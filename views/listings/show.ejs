<% layout("/layouts/boilerplate") %>
<%
  const now = new Date();
  const todayUtc = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
  const tomorrowUtc = new Date(todayUtc.getTime() + 24 * 60 * 60 * 1000);
  const pad = (n) => String(n).padStart(2, '0');
  const todayStr = `${todayUtc.getUTCFullYear()}-${pad(todayUtc.getUTCMonth() + 1)}-${pad(todayUtc.getUTCDate())}`;
  const tomorrowStr = `${tomorrowUtc.getUTCFullYear()}-${pad(tomorrowUtc.getUTCMonth() + 1)}-${pad(tomorrowUtc.getUTCDate())}`;
  const isOwnerUser = currentUser && listing.owner && (listing.owner._id ? listing.owner._id.equals(currentUser._id) : listing.owner.equals(currentUser._id));
  const hostName = (listing.owner && listing.owner.name) ? listing.owner.name : "StayNest Community Host";
  const hostInitial = hostName.charAt(0).toUpperCase();
%>

<!-- Navigation Breadcrumb / Back Link -->
<div class="mb-3">
  <a href="/listings" class="btn btn-outline-dark btn-sm">
    <i class="fa-solid fa-arrow-left me-1"></i> Back to all stays
  </a>
</div>

<div class="row g-4 g-lg-5">
  <!-- Left Column: Property Media, Information & Description -->
  <div class="col-12 col-lg-7">
    <!-- Header Title & Location -->
    <div class="mb-3">
      <h1 class="show-header-title"><%= listing.title %></h1>
      <div class="d-flex align-items-center gap-2 text-muted">
        <i class="fa-solid fa-location-dot text-danger"></i>
        <span class="fw-semibold text-secondary"><%= listing.location %>, <%= listing.country %></span>
      </div>
    </div>

    <!-- Hero Image -->
    <div class="mb-4">
      <img
        src="<%= listing.image.url %>"
        class="show-hero-img"
        alt="<%= listing.title %>"
      />
    </div>

    <!-- Host Information Card -->
    <div class="d-flex align-items-center gap-3 py-3 border-top border-bottom mb-4">
      <div class="host-avatar-badge">
        <%= hostInitial %>
      </div>
      <div>
        <div class="fw-bold text-dark">Hosted by <%= hostName %></div>
        <small class="text-muted"><i class="fa-solid fa-shield-halved text-success me-1"></i>Verified StayNest Host</small>
      </div>
    </div>

    <!-- Description Section -->
    <div class="mb-4">
      <h2 class="h5 fw-bold text-dark mb-2">About this space</h2>
      <p class="text-secondary" style="line-height: 1.7; white-space: pre-line;"><%= listing.description %></p>
    </div>

    <!-- Host Actions (Owner Only) -->
    <% if (isOwnerUser) { %>
      <div class="card bg-light border-0 rounded-4 p-3 mb-4">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="fw-semibold text-dark"><i class="fa-solid fa-crown text-warning me-1"></i> Host Controls</div>
            <small class="text-muted">You are the owner of this property.</small>
          </div>
          <div class="d-flex gap-2">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark btn-sm">
              <i class="fa-solid fa-pen-to-square me-1"></i> Edit Stay
            </a>
            <form method="post" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this property? This action cannot be undone.');">
                <i class="fa-solid fa-trash me-1"></i> Delete Stay
              </button>
            </form>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Right Column: Sticky Booking Widget -->
  <div class="col-12 col-lg-5">
    <div class="card booking-sticky-card sticky-top">
      <!-- Price Header -->
      <div class="d-flex justify-content-between align-items-baseline mb-3 pb-3 border-bottom">
        <div>
          <span class="fs-3 fw-bold text-dark">
            &#8377;<%= (listing.price !== undefined && listing.price !== null) ? listing.price.toLocaleString("en-IN") : "0" %>
          </span>
          <span class="text-muted fw-normal">/ night</span>
        </div>
        <span class="badge bg-light text-secondary border px-3 py-2 fw-semibold">
          <i class="fa-solid fa-bolt me-1 text-warning"></i> Instant Book
        </span>
      </div>

      <!-- Booking Form -->
      <form method="POST" action="/listings/<%= listing._id %>/reservations" id="bookingForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <!-- Check-in & Check-out Grid -->
        <div class="row g-2 mb-3">
          <div class="col-6">
            <label for="showCheckIn" class="form-label small">
              <i class="fa-regular fa-calendar-check me-1 text-danger"></i> Check-in
            </label>
            <input
              type="date"
              class="form-control"
              id="showCheckIn"
              name="checkIn"
              min="<%= todayStr %>"
              value="<%= todayStr %>"
              required
            />
          </div>
          <div class="col-6">
            <label for="showCheckOut" class="form-label small">
              <i class="fa-regular fa-calendar-xmark me-1 text-danger"></i> Check-out
            </label>
            <input
              type="date"
              class="form-control"
              id="showCheckOut"
              name="checkOut"
              min="<%= tomorrowStr %>"
              value="<%= tomorrowStr %>"
              required
            />
          </div>
        </div>

        <!-- Guests Selection -->
        <div class="mb-3">
          <label for="showGuests" class="form-label small">
            <i class="fa-solid fa-user-group me-1 text-danger"></i> Guests
          </label>
          <input
            type="number"
            class="form-control"
            id="showGuests"
            name="guests"
            min="1"
            max="50"
            value="1"
            required
          />
        </div>

        <!-- Price Breakdown Receipt Box -->
        <div class="booking-receipt-box mb-4">
          <div class="d-flex justify-content-between mb-2 small text-secondary">
            <span>&#8377;<%= (listing.price !== undefined && listing.price !== null) ? listing.price.toLocaleString("en-IN") : "0" %> &times; <span id="showNightsSpan">1</span> night(s)</span>
            <span id="showSubtotalSpan" class="fw-semibold">&#8377;<%= (listing.price !== undefined && listing.price !== null) ? listing.price.toLocaleString("en-IN") : "0" %></span>
          </div>
          <hr class="my-2 border-secondary-subtle" />
          <div class="d-flex justify-content-between fw-bold text-dark fs-5">
            <span>Total Estimated</span>
            <span id="showTotalSpan">&#8377;<%= (listing.price !== undefined && listing.price !== null) ? listing.price.toLocaleString("en-IN") : "0" %></span>
          </div>
        </div>

        <!-- Action Button -->
        <% if (currentUser) { %>
          <button
            type="submit"
            class="btn btn-brand w-100 py-3 fs-6 fw-semibold"
          >
            <i class="fa-solid fa-calendar-check me-2"></i> Reserve Stay
          </button>
          <div class="text-center mt-2">
            <small class="text-muted"><i class="fa-solid fa-lock me-1"></i> You won't be charged yet</small>
          </div>
        <% } else { %>
          <a
            href="/login"
            class="btn btn-brand w-100 py-3 fs-6 fw-semibold text-center d-block"
          >
            <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Sign In to Reserve
          </a>
          <div class="text-center mt-2">
            <small class="text-muted">Sign in or create an account to reserve dates</small>
          </div>
        <% } %>
      </form>
    </div>
  </div>
</div>

<script>
  (function () {
    const nightlyRate = <%= Number(listing.price) || 0 %>;
    const inEl = document.getElementById("showCheckIn");
    const outEl = document.getElementById("showCheckOut");
    const nightsSpan = document.getElementById("showNightsSpan");
    const subtotalSpan = document.getElementById("showSubtotalSpan");
    const totalSpan = document.getElementById("showTotalSpan");

    if (!inEl || !outEl) return;

    function recalculate() {
      if (!inEl.value || !outEl.value) return;
      const d1 = new Date(inEl.value + "T00:00:00Z");
      const d2 = new Date(outEl.value + "T00:00:00Z");
      const diffMs = d2.getTime() - d1.getTime();
      const nights = Math.round(diffMs / (1000 * 60 * 60 * 24));

      if (nights >= 1) {
        const total = nights * nightlyRate;
        nightsSpan.textContent = nights;
        subtotalSpan.textContent = "₹" + total.toLocaleString("en-IN");
        totalSpan.textContent = "₹" + total.toLocaleString("en-IN");
      } else {
        nightsSpan.textContent = "0";
        subtotalSpan.textContent = "Invalid dates";
        totalSpan.textContent = "—";
      }
    }

    inEl.addEventListener("change", function () {
      if (inEl.value) {
        const nextDay = new Date(new Date(inEl.value + "T00:00:00Z").getTime() + 86400000);
        const y = nextDay.getUTCFullYear();
        const m = String(nextDay.getUTCMonth() + 1).padStart(2, "0");
        const d = String(nextDay.getUTCDate()).padStart(2, "0");
        outEl.min = `${y}-${m}-${d}`;
        if (outEl.value && outEl.value <= inEl.value) {
          outEl.value = outEl.min;
        }
      }
      recalculate();
    });

    outEl.addEventListener("change", recalculate);
    recalculate();
  })();
</script>
