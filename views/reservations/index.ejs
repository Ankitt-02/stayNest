<% layout("/layouts/boilerplate") %>

<div class="mb-4">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
    <div>
      <h1 class="h2 fw-bold text-dark mb-1">
        <i class="fa-solid fa-suitcase me-2 text-danger"></i> My Reservations
      </h1>
      <p class="text-muted mb-0">Track and manage your upcoming and past accommodation bookings.</p>
    </div>
    <div>
      <a href="/listings" class="btn btn-outline-dark">
        <i class="fa-solid fa-magnifying-glass me-1"></i> Explore More Stays
      </a>
    </div>
  </div>
</div>

<% if (reservations.length === 0) { %>
  <!-- Empty State -->
  <div class="empty-state-card my-4">
    <div class="empty-state-icon">
      <i class="fa-solid fa-calendar-xmark"></i>
    </div>
    <h2 class="h4 fw-semibold text-dark mb-2">No reservations found</h2>
    <p class="text-muted mb-4 mx-auto" style="max-width: 480px;">
      You haven't booked any stays yet. Explore our handpicked property listings across India and book your next trip today!
    </p>
    <a href="/listings" class="btn btn-brand px-4 py-2">
      <i class="fa-solid fa-house me-1"></i> Browse All Stays
    </a>
  </div>
<% } else { %>
  <!-- Reservations Grid -->
  <div class="row g-4">
    <% for (let reservation of reservations) { %>
      <%
        const listing = reservation.listing;
        const nights = calculateNights(reservation.checkIn, reservation.checkOut);
        const isConfirmed = reservation.status === "CONFIRMED";
      %>
      <div class="col-12 col-lg-6">
        <div class="card reservation-card h-100">
          <div class="row g-0 h-100">
            <!-- Property Thumbnail Column -->
            <div class="col-12 col-sm-5 position-relative">
              <div class="reservation-thumb-wrapper">
                <% if (listing && listing.image && listing.image.url) { %>
                  <img
                    src="<%= listing.image.url %>"
                    alt="<%= listing.title %>"
                    class="reservation-thumb-img"
                    loading="lazy"
                  />
                <% } else { %>
                  <div class="d-flex align-items-center justify-content-center h-100 bg-light text-muted">
                    <i class="fa-solid fa-mountain-city fs-1 text-secondary opacity-50"></i>
                  </div>
                <% } %>
                <div class="position-absolute top-0 start-0 m-2">
                  <% if (isConfirmed) { %>
                    <span class="status-badge-confirmed shadow-sm">
                      <i class="fa-solid fa-circle-check me-1"></i>Confirmed
                    </span>
                  <% } else { %>
                    <span class="status-badge-cancelled shadow-sm">
                      <i class="fa-solid fa-ban me-1"></i>Cancelled
                    </span>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Reservation Details Column -->
            <div class="col-12 col-sm-7 d-flex flex-column">
              <div class="card-body p-3 p-md-4 flex-grow-1">
                <% if (listing) { %>
                  <h2 class="h5 fw-bold mb-1">
                    <a href="/listings/<%= listing._id %>" class="text-dark text-decoration-none">
                      <%= listing.title %>
                    </a>
                  </h2>
                  <div class="text-muted small mb-3">
                    <i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %>
                  </div>
                <% } else { %>
                  <h2 class="h5 fw-bold text-muted mb-1">Property No Longer Available</h2>
                  <div class="text-muted small mb-3">This listing has been archived or removed.</div>
                <% } %>

                <!-- Booking Info Receipt Box -->
                <div class="booking-receipt-box mb-3 small">
                  <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted"><i class="fa-regular fa-calendar me-1"></i> Dates:</span>
                    <span class="fw-semibold text-dark">
                      <%= formatDateDisplay(reservation.checkIn) %> &rarr; <%= formatDateDisplay(reservation.checkOut) %>
                    </span>
                  </div>
                  <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted"><i class="fa-regular fa-moon me-1"></i> Duration:</span>
                    <span class="fw-semibold text-dark"><%= nights %> <%= nights === 1 ? 'night' : 'nights' %></span>
                  </div>
                  <div class="d-flex justify-content-between">
                    <span class="text-muted"><i class="fa-solid fa-user-group me-1"></i> Guests:</span>
                    <span class="fw-semibold text-dark"><%= reservation.guests %> <%= reservation.guests === 1 ? 'guest' : 'guests' %></span>
                  </div>
                </div>

                <!-- Price Row -->
                <div class="d-flex justify-content-between align-items-baseline pt-1">
                  <span class="small text-muted fw-medium">Total Amount:</span>
                  <span class="fs-5 fw-bold text-dark">
                    &#8377;<%= (reservation.totalPrice !== undefined && reservation.totalPrice !== null) ? reservation.totalPrice.toLocaleString("en-IN") : "0" %>
                  </span>
                </div>
              </div>

              <!-- Action Footer -->
              <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3 px-md-4">
                <div class="d-flex justify-content-between align-items-center gap-2">
                  <% if (listing) { %>
                    <a href="/listings/<%= listing._id %>" class="btn btn-outline-dark btn-sm">
                      <i class="fa-regular fa-eye me-1"></i> View Stay
                    </a>
                  <% } %>

                  <% if (isConfirmed) { %>
                    <form
                      method="POST"
                      action="/reservations/<%= reservation._id %>/cancel"
                      onsubmit="return confirm('Are you sure you want to cancel this reservation? The booked dates will be released immediately.');"
                      class="d-inline ms-auto"
                    >
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i class="fa-solid fa-xmark me-1"></i> Cancel
                      </button>
                    </form>
                  <% } else { %>
                    <span class="badge bg-light text-muted border ms-auto small">
                      Dates Released
                    </span>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>
<% } %>
