<% layout("/layouts/boilerplate") %>

<div class="container my-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1"><i class="fa-solid fa-suitcase me-2 text-danger"></i>My Reservations</h2>
      <p class="text-muted mb-0">View, manage, and track your booked stays across StayNest.</p>
    </div>
    <a href="/listings" class="btn btn-outline-dark">
      <i class="fa-solid fa-magnifying-glass me-1"></i> Explore More Stays
    </a>
  </div>

  <% if (reservations.length === 0) { %>
    <div class="card border-0 shadow-sm rounded-4 text-center py-5 my-4 bg-light">
      <div class="card-body">
        <i class="fa-solid fa-calendar-xmark text-muted mb-3" style="font-size: 3.5rem;"></i>
        <h4 class="fw-semibold text-secondary">No reservations yet</h4>
        <p class="text-muted mb-4">
          You haven't booked any stays yet. Discover our curated accommodation stays and book your next getaway!
        </p>
        <a href="/listings" class="btn btn-danger px-4 py-2" style="background-color: #fe424d; border-color: #fe424d;">
          <i class="fa-solid fa-house me-1"></i> Browse All Stays
        </a>
      </div>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% for (let reservation of reservations) { %>
        <%
          const listing = reservation.listing;
          const nights = calculateNights(reservation.checkIn, reservation.checkOut);
          const isConfirmed = reservation.status === "CONFIRMED";
        %>
        <div class="col-12 col-md-6 col-lg-6">
          <div class="card h-100 shadow-sm border rounded-4 overflow-hidden">
            <div class="row g-0 h-100">
              <!-- Thumbnail -->
              <div class="col-sm-5 position-relative">
                <% if (listing && listing.image && listing.image.url) { %>
                  <img
                    src="<%= listing.image.url %>"
                    alt="<%= listing.title %>"
                    class="img-fluid h-100 w-100 object-fit-cover"
                    style="min-height: 180px; max-height: 240px;"
                  />
                <% } else { %>
                  <div class="bg-secondary text-white d-flex align-items-center justify-content-center h-100" style="min-height: 180px;">
                    <i class="fa-solid fa-mountain-city fs-1"></i>
                  </div>
                <% } %>
                <div class="position-absolute top-0 start-0 m-2">
                  <% if (isConfirmed) { %>
                    <span class="badge bg-success shadow-sm">
                      <i class="fa-solid fa-circle-check me-1"></i>Confirmed
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary shadow-sm">
                      <i class="fa-solid fa-ban me-1"></i>Cancelled
                    </span>
                  <% } %>
                </div>
              </div>

              <!-- Details -->
              <div class="col-sm-7 d-flex flex-column">
                <div class="card-body p-3 flex-grow-1">
                  <% if (listing) { %>
                    <h5 class="card-title fw-bold mb-1">
                      <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
                        <%= listing.title %>
                      </a>
                    </h5>
                    <p class="text-muted small mb-2">
                      <i class="fa-solid fa-location-dot me-1 text-danger"></i><%= listing.location %>, <%= listing.country %>
                    </p>
                  <% } else { %>
                    <h5 class="card-title fw-bold text-muted mb-1">Stay No Longer Available</h5>
                    <p class="text-muted small mb-2">This listing has been archived or removed.</p>
                  <% } %>

                  <div class="bg-light p-2 rounded-3 mb-2 small">
                    <div class="d-flex justify-content-between mb-1">
                      <span class="text-muted">Dates:</span>
                      <span class="fw-semibold">
                        <%= formatDateDisplay(reservation.checkIn) %> &rarr; <%= formatDateDisplay(reservation.checkOut) %>
                      </span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                      <span class="text-muted">Duration:</span>
                      <span class="fw-semibold"><%= nights %> <%= nights === 1 ? 'night' : 'nights' %></span>
                    </div>
                    <div class="d-flex justify-content-between">
                      <span class="text-muted">Guests:</span>
                      <span class="fw-semibold"><%= reservation.guests %> <%= reservation.guests === 1 ? 'guest' : 'guests' %></span>
                    </div>
                  </div>

                  <div class="d-flex justify-content-between align-items-center mt-2">
                    <span class="small text-muted">Total Paid:</span>
                    <span class="fs-5 fw-bold text-dark">
                      &#8377;<%= (reservation.totalPrice !== undefined && reservation.totalPrice !== null) ? reservation.totalPrice.toLocaleString("en-IN") : "0" %>
                    </span>
                  </div>
                </div>

                <!-- Footer with Actions -->
                <div class="card-footer bg-white border-top-0 pt-0 pb-3 px-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <% if (listing) { %>
                      <a href="/listings/<%= listing._id %>" class="btn btn-outline-dark btn-sm">
                        View Stay
                      </a>
                    <% } %>

                    <% if (isConfirmed) { %>
                      <form
                        method="POST"
                        action="/reservations/<%= reservation._id %>/cancel"
                        onsubmit="return confirm('Are you sure you want to cancel this reservation? The dates will be released for other guests.');"
                        class="d-inline ms-auto"
                      >
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                          <i class="fa-solid fa-xmark me-1"></i>Cancel
                        </button>
                      </form>
                    <% } else { %>
                      <span class="badge bg-light text-muted border ms-auto">
                        Dates Released
                      </span>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
