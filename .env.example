# StayNest Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual settings.
# NEVER commit your real .env file or production credentials to source control.

# MongoDB Connection String (Atlas or Local MongoDB)
# Format for Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/staynest?retryWrites=true&w=majority
# Format for Local: mongodb://127.0.0.1:27017/staynest
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/staynest?retryWrites=true&w=majority

# Express Session Secret (use a long, cryptographically random string)
SESSION_SECRET=your_super_secret_session_key_replace_in_production_min_32_chars

# Application Port (defaults to 3000 if not specified)
PORT=3000

# Environment Mode (development | production | test)
NODE_ENV=development
